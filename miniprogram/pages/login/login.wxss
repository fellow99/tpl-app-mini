/**login.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
  background: var(--color-bg);
}

.login-container {
  display: flex;
  flex-direction: column;
  padding: 40rpx 60rpx;
  box-sizing: border-box;
}

.tab-switch {
  display: flex;
  justify-content: center;
  margin-bottom: 60rpx;
}

.tab {
  font-size: 32rpx;
  color: var(--color-text-secondary);
  padding: 16rpx 40rpx;
  position: relative;
}

.tab.active {
  color: var(--color-primary);
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
}

.form-item {
  margin-bottom: 32rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: var(--color-disabled);
  color: var(--color-text);
  border-radius: 12rpx;
  font-size: 30rpx;
}

.password-item {
  position: relative;
}

.eye {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 26rpx;
  color: var(--color-primary);
}

.captcha-row {
  display: flex;
  align-items: center;
}

.captcha-row .input {
  flex: 1;
  margin-right: 20rpx;
}

.captcha-img {
  width: 200rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: var(--color-disabled);
}

.captcha-box {
  width: 200rpx;
  height: 88rpx;
  flex-shrink: 0;
}

.captcha-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  text-align: center;
  box-sizing: border-box;
}

.submit-btn {
  height: 88rpx;
  line-height: 88rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  margin-top: 40rpx;
}

.submit-btn[disabled] {
  background: var(--color-primary-disabled);
  color: #fff;
}

.sms-btn {
  width: 200rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 26rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: 12rpx;
  padding: 0;
}

.sms-btn[disabled] {
  background: var(--color-primary-disabled);
  color: #fff;
}

.separator {
  text-align: center;
  color: var(--color-border);
  font-size: 26rpx;
  margin: 80rpx 0 40rpx;
}

.wechat-btn {
  height: 88rpx;
  line-height: 88rpx;
  background: var(--color-surface);
  color: var(--color-wechat);
  font-size: 30rpx;
  border: 2rpx solid var(--color-wechat);
  border-radius: 44rpx;
}

.wechat-btn[disabled] {
  opacity: 0.6;
}

.register-link {
  text-align: center;
  color: var(--color-primary);
  font-size: 28rpx;
  margin-top: 40rpx;
}

/* 主题切换按钮（登录页右上角圆形 emoji，≥44px 点击区域） */
.lang-toggle {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 44rpx;
  border-radius: 50%;
  background: var(--color-disabled);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.theme-toggle {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 44rpx;
  border-radius: 50%;
  background: var(--color-disabled);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.theme-toggle-hover {
  opacity: 0.7;
}
