/**profile-edit.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
  background: var(--color-bg);
}

.edit-container {
  display: flex;
  flex-direction: column;
  padding: 40rpx;
  box-sizing: border-box;
}

.form-item {
  margin-bottom: 32rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: var(--color-surface);
  color: var(--color-text);
  border-radius: 12rpx;
  font-size: 30rpx;
}

.picker-value {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  background: var(--color-surface);
  border-radius: 12rpx;
  font-size: 30rpx;
  color: var(--color-text);
}

.picker-value.placeholder {
  color: var(--color-text-secondary);
}

.captcha-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.captcha-row .input {
  flex: 1;
}

.captcha-box {
  flex-shrink: 0;
}

.captcha-img {
  width: 180rpx;
  height: 84rpx;
  border-radius: 12rpx;
}

.captcha-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-disabled);
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.submit-btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
}

.submit-btn[disabled] {
  background: var(--color-primary-disabled);
}
