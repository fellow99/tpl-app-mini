<navigation-bar title="{{navTitle}}" back="{{true}}" color="{{navColor}}" background="{{navBg}}"></navigation-bar>
<scroll-view class="scrollarea {{themeClass}}" scroll-y type="list">
  <view class="pwd-container">

    <view wx:if="{{!isEmptyPassword}}" class="form-item">
      <text class="field-label">{{oldPasswordLabel}}</text>
      <input class="input" type="password" placeholder="{{oldPasswordPlaceholder}}" value="{{oldPassword}}" bindinput="onOldPasswordInput" />
    </view>

    <view class="form-item">
      <text class="field-label">{{newPasswordLabel}}</text>
      <input class="input" type="password" placeholder="{{newPasswordPlaceholder}}" value="{{newPassword}}" bindinput="onNewPasswordInput" />
    </view>

    <view class="form-item">
      <text class="field-label">{{confirmNewPasswordLabel}}</text>
      <input class="input" type="password" placeholder="{{confirmNewPasswordPlaceholder}}" value="{{confirmNewPassword}}" bindinput="onConfirmNewPasswordInput" />
    </view>

    <view class="form-item captcha-row">
      <input class="input" type="number" maxlength="6" placeholder="{{smsCodePlaceholder}}" value="{{smsCode}}" bindinput="onSmsCodeInput" />
      <button class="sms-btn" bindtap="handleSendSms" disabled="{{smsCountdown > 0 || sendingSms}}">
        {{smsCountdown > 0 ? smsCountdown + 's' : getCodeText}}
      </button>
    </view>

    <view wx:if="{{captchaEnabled}}" class="form-item captcha-row">
      <input class="input" placeholder="{{captchaPlaceholder}}" value="{{captchaInput}}" bindinput="onCaptchaInput" />
      <view class="captcha-box" bindtap="onCaptchaTap">
        <image wx:if="{{!captchaError && captchaImg}}" class="captcha-img" src="{{captchaImg}}" />
        <view wx:else class="captcha-img captcha-placeholder">{{captchaError ? captchaRetry : captchaLoading}}</view>
      </view>
    </view>

    <button class="submit-btn" bindtap="handleSubmit" disabled="{{isLoading}}">{{submitText}}</button>

  </view>
</scroll-view>
